<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VideoBoost.App.Views.Controls.RunCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">

        <!-- Кнопки: слот StartButton не прыгает при обработке (скрываем прозрачностью, не Collapsed). -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button
                x:Name="StartButton"
                Content="▶  Начать обработку"
                Style="{StaticResource VbAccentButtonStyle}"
                IsEnabled="False"
                Click="StartButton_Click"
                ToolTipService.ToolTip="Обработать все выбранные видео с этими настройками" />
            <Button
                x:Name="CancelButton"
                Content="Отмена"
                Style="{StaticResource VbDangerButtonStyle}"
                IsEnabled="False"
                Click="CancelButton_Click"
                ToolTipService.ToolTip="Остановить обработку и удалить временные файлы" />
            <Button
                x:Name="OpenFolderButton"
                Content="Открыть папку"
                Style="{StaticResource VbSecondaryButtonStyle}"
                IsEnabled="False"
                ToolTipService.ToolTip="Показать папку с готовыми файлами" />
        </StackPanel>

        <!-- Зарезервированный ряд прогресса: кольцо + полоса + проценты (D5) -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                x:Name="BoostRing"
                Grid.Column="0"
                Width="20"
                Height="20"
                IsActive="False"
                VerticalAlignment="Center"
                AutomationProperties.Name="Ход обработки" />

            <ProgressBar
                x:Name="BoostProgress"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                Value="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Прогресс обработки" />

            <TextBlock
                x:Name="BoostPercentText"
                Grid.Column="2"
                Text="0%"
                MinWidth="44"
                TextAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource VbSectionTitleStyle}" />
        </Grid>

        <!-- Статус шага и «файл N из M» -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="BoostStatusText"
                Grid.Column="0"
                Text="Готов к работе"
                Style="{StaticResource VbCaptionStyle}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="CurrentFileText"
                Grid.Column="1"
                Text=""
                Style="{StaticResource VbCaptionStyle}"
                TextAlignment="Right" />
        </Grid>
    </StackPanel>
</UserControl>
