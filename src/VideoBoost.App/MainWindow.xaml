<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoBoost.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource VbBackdropBrush}" Padding="32">
        <StackPanel VerticalAlignment="Center" Spacing="10">
            <TextBlock
                Text="VideoBoost"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="{ThemeResource VbTextBrush}" />
            <TextBlock
                Text="Апскейл до 8K и плавность до 120 FPS — версия v3 (C#). Скелет конвейера."
                FontSize="14"
                Foreground="{ThemeResource VbMutedBrush}"
                TextWrapping="Wrap" />

            <Border
                Background="{ThemeResource VbCardBrush}"
                BorderBrush="{ThemeResource VbCardEdgeBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource VbCardRadius}"
                Padding="{ThemeResource VbCardPadding}"
                Margin="0,16,0,0">
                <StackPanel Spacing="12">
                    <Button x:Name="AddVideoButton" Content="Добавить видео…" Click="OnAddVideo" />
                    <TextBlock
                        x:Name="LogLine"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Нажми кнопку — покажу план обработки. Дальше этот лист ведёт настоящий пайплайн."
                        Foreground="{ThemeResource VbMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
