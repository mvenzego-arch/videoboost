<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        Палитра-ДНК VideoBoost v3 (§3.2). Обе темы живут в ThemeDictionaries:
        Dark — синяя ночь, Light — дневное стекло. RequestedTheme нигде не задаётся.
        Внутри ThemeDictionaries используем StaticResource (правило WinUI).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- §3.2 палитра -->
            <Color x:Key="VbBackdropColor">#FF070809</Color>
            <Color x:Key="VbCardColor">#B810141B</Color>
            <Color x:Key="VbCardEdgeColor">#FF1C2333</Color>
            <Color x:Key="VbTextColor">#FFE8EEF8</Color>
            <Color x:Key="VbMutedColor">#FF93A3BC</Color>
            <Color x:Key="VbAccentColor">#FF7C5CFF</Color>
            <Color x:Key="VbAccentFillColor">#FF6A4BE3</Color>
            <Color x:Key="VbAccentFillHoverColor">#FF5F41D6</Color>
            <Color x:Key="VbAccentFillPressedColor">#FF5236BC</Color>
            <Color x:Key="VbCyanColor">#FF22D3EE</Color>
            <Color x:Key="VbCyanTrackColor">#3322D3EE</Color>
            <Color x:Key="VbSuccessColor">#FF86EFAC</Color>
            <Color x:Key="VbWarningColor">#FFFCD34D</Color>
            <Color x:Key="VbDangerColor">#FFFCA5A5</Color>
            <Color x:Key="VbJournalColor">#FF0F131A</Color>
            <Color x:Key="VbJournalTextColor">#FFD6DEEE</Color>

            <!-- Производные подложки (та же шкала, без второго стиля) -->
            <Color x:Key="VbSubtleFillColor">#0FFFFFFF</Color>
            <Color x:Key="VbPillHoverColor">#14FFFFFF</Color>
            <Color x:Key="VbPillPressedColor">#1FFFFFFF</Color>
            <Color x:Key="VbDangerTintColor">#1FFCA5A5</Color>

            <SolidColorBrush x:Key="VbBackdropBrush" Color="{StaticResource VbBackdropColor}" />
            <SolidColorBrush x:Key="VbCardBrush" Color="{StaticResource VbCardColor}" />
            <SolidColorBrush x:Key="VbCardEdgeBrush" Color="{StaticResource VbCardEdgeColor}" />
            <SolidColorBrush x:Key="VbTextColorBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="VbMutedBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="VbAccentBrush" Color="{StaticResource VbAccentColor}" />
            <SolidColorBrush x:Key="VbAccentFillBrush" Color="{StaticResource VbAccentFillColor}" />
            <SolidColorBrush x:Key="VbAccentFillHoverBrush" Color="{StaticResource VbAccentFillHoverColor}" />
            <SolidColorBrush x:Key="VbAccentFillPressedBrush" Color="{StaticResource VbAccentFillPressedColor}" />
            <SolidColorBrush x:Key="VbCyanBrush" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="VbCyanTrackBrush" Color="{StaticResource VbCyanTrackColor}" />
            <SolidColorBrush x:Key="VbSuccessBrush" Color="{StaticResource VbSuccessColor}" />
            <SolidColorBrush x:Key="VbWarningBrush" Color="{StaticResource VbWarningColor}" />
            <SolidColorBrush x:Key="VbDangerBrush" Color="{StaticResource VbDangerColor}" />
            <SolidColorBrush x:Key="VbJournalBrush" Color="{StaticResource VbJournalColor}" />
            <SolidColorBrush x:Key="VbJournalTextBrush" Color="{StaticResource VbJournalTextColor}" />
            <SolidColorBrush x:Key="VbSubtleFillBrush" Color="{StaticResource VbSubtleFillColor}" />
            <SolidColorBrush x:Key="VbPillBrush" Color="Transparent" />
            <SolidColorBrush x:Key="VbPillHoverBrush" Color="{StaticResource VbPillHoverColor}" />
            <SolidColorBrush x:Key="VbPillPressedBrush" Color="{StaticResource VbPillPressedColor}" />
            <SolidColorBrush x:Key="VbPillForegroundBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="VbPillSelectedForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VbDangerTintBrush" Color="{StaticResource VbDangerTintColor}" />

            <!-- SystemAccentColor override = #7C5CFF (не зависит от темы) -->
            <Color x:Key="SystemAccentColor">#FF7C5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF896CFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF967DFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA38DFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF7053E6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF634ACC</Color>
            <Color x:Key="SystemAccentColorDark3">#FF5740B3</Color>

            <!-- CTA/выбранная пилюля: белый текст на #6A4BE3 (5.6:1), не на #7C5CFF -->
            <Color x:Key="AccentFillColorDefault">#FF6A4BE3</Color>
            <Color x:Key="AccentFillColorSecondary">#FF5F41D6</Color>
            <Color x:Key="AccentFillColorTertiary">#FF5236BC</Color>
            <Color x:Key="AccentFillColorDisabled">#4D7C5CFF</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentFillColorSecondary}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentFillColorTertiary}" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{StaticResource AccentFillColorDisabled}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource VbAccentColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{StaticResource VbMutedColor}" />

            <!-- Маппинг токенов на Fluent-ключи (§3.2) -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource VbCardColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource VbCardEdgeColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource VbCardEdgeColor}" />

            <!-- Голубой — только телеметрия: прогресс/кольцо -->
            <Color x:Key="ProgressBarForegroundColor">#FF22D3EE</Color>
            <Color x:Key="ProgressBarBackgroundColor">#3322D3EE</Color>
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource VbCyanTrackColor}" />
            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="{StaticResource VbCyanTrackColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- §3.2 палитра -->
            <Color x:Key="VbBackdropColor">#FFF3F6FB</Color>
            <Color x:Key="VbCardColor">#B2FFFFFF</Color>
            <Color x:Key="VbCardEdgeColor">#FFDCE1EC</Color>
            <Color x:Key="VbTextColor">#FF1A2028</Color>
            <Color x:Key="VbMutedColor">#FF5B6472</Color>
            <Color x:Key="VbAccentColor">#FF7C5CFF</Color>
            <Color x:Key="VbAccentFillColor">#FF5A3FD9</Color>
            <Color x:Key="VbAccentFillHoverColor">#FF4C33C4</Color>
            <Color x:Key="VbAccentFillPressedColor">#FF4029A8</Color>
            <Color x:Key="VbCyanColor">#FF0891B2</Color>
            <Color x:Key="VbCyanTrackColor">#330891B2</Color>
            <Color x:Key="VbSuccessColor">#FF15803D</Color>
            <Color x:Key="VbWarningColor">#FFB45309</Color>
            <Color x:Key="VbDangerColor">#FFB91C1C</Color>
            <Color x:Key="VbJournalColor">#99FFFFFF</Color>
            <Color x:Key="VbJournalTextColor">#FF1A2028</Color>

            <Color x:Key="VbSubtleFillColor">#0F000000</Color>
            <Color x:Key="VbPillHoverColor">#14000000</Color>
            <Color x:Key="VbPillPressedColor">#1F000000</Color>
            <Color x:Key="VbDangerTintColor">#1FB91C1C</Color>

            <SolidColorBrush x:Key="VbBackdropBrush" Color="{StaticResource VbBackdropColor}" />
            <SolidColorBrush x:Key="VbCardBrush" Color="{StaticResource VbCardColor}" />
            <SolidColorBrush x:Key="VbCardEdgeBrush" Color="{StaticResource VbCardEdgeColor}" />
            <SolidColorBrush x:Key="VbTextColorBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="VbMutedBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="VbAccentBrush" Color="{StaticResource VbAccentColor}" />
            <SolidColorBrush x:Key="VbAccentFillBrush" Color="{StaticResource VbAccentFillColor}" />
            <SolidColorBrush x:Key="VbAccentFillHoverBrush" Color="{StaticResource VbAccentFillHoverColor}" />
            <SolidColorBrush x:Key="VbAccentFillPressedBrush" Color="{StaticResource VbAccentFillPressedColor}" />
            <SolidColorBrush x:Key="VbCyanBrush" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="VbCyanTrackBrush" Color="{StaticResource VbCyanTrackColor}" />
            <SolidColorBrush x:Key="VbSuccessBrush" Color="{StaticResource VbSuccessColor}" />
            <SolidColorBrush x:Key="VbWarningBrush" Color="{StaticResource VbWarningColor}" />
            <SolidColorBrush x:Key="VbDangerBrush" Color="{StaticResource VbDangerColor}" />
            <SolidColorBrush x:Key="VbJournalBrush" Color="{StaticResource VbJournalColor}" />
            <SolidColorBrush x:Key="VbJournalTextBrush" Color="{StaticResource VbJournalTextColor}" />
            <SolidColorBrush x:Key="VbSubtleFillBrush" Color="{StaticResource VbSubtleFillColor}" />
            <SolidColorBrush x:Key="VbPillBrush" Color="Transparent" />
            <SolidColorBrush x:Key="VbPillHoverBrush" Color="{StaticResource VbPillHoverColor}" />
            <SolidColorBrush x:Key="VbPillPressedBrush" Color="{StaticResource VbPillPressedColor}" />
            <SolidColorBrush x:Key="VbPillForegroundBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="VbPillSelectedForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="VbDangerTintBrush" Color="{StaticResource VbDangerTintColor}" />

            <!-- SystemAccentColor override = #7C5CFF (не меняется в Light) -->
            <Color x:Key="SystemAccentColor">#FF7C5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF896CFF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF967DFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA38DFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF7053E6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF634ACC</Color>
            <Color x:Key="SystemAccentColorDark3">#FF5740B3</Color>

            <!-- В Light заливка темнее: белый текст держит ≥ 4.5:1 -->
            <Color x:Key="AccentFillColorDefault">#FF5A3FD9</Color>
            <Color x:Key="AccentFillColorSecondary">#FF4C33C4</Color>
            <Color x:Key="AccentFillColorTertiary">#FF4029A8</Color>
            <Color x:Key="AccentFillColorDisabled">#4D7C5CFF</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentFillColorDefault}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentFillColorSecondary}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentFillColorTertiary}" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{StaticResource AccentFillColorDisabled}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66FFFFFF" />
            <!-- В Light #7C5CFF как текст не используется — берём #5A3FD9 -->
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource VbAccentFillColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="{StaticResource VbMutedColor}" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource VbTextColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource VbMutedColor}" />
            <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource VbCardColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource VbCardEdgeColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource VbCardEdgeColor}" />

            <Color x:Key="ProgressBarForegroundColor">#FF0891B2</Color>
            <Color x:Key="ProgressBarBackgroundColor">#330891B2</Color>
            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource VbCyanTrackColor}" />
            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource VbCyanColor}" />
            <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="{StaticResource VbCyanTrackColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== Стеклянные карточки ==================== -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VbCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VbCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Drop-зона пустого состояния: тот же язык, что у карточек -->
    <Style x:Key="DropZoneStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VbSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VbCardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="180" />
    </Style>

    <!--
        Пилюля-чип: обёртка над CommunityToolkit SegmentedItem.
        Высота 32; пресеты выше за счёт контента «заголовок + подпись» (итог 48).
        Выбранная пилюля — VbAccentFillBrush с белым текстом (§3.2).
    -->
    <Style x:Key="PillItemStyle" TargetType="controls:SegmentedItem">
        <Setter Property="Background" Value="{ThemeResource VbPillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource VbPillForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentedItem">
                    <Grid x:Name="PillRoot"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource VbPillHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource VbPillPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource VbAccentFillBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource VbPillSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource VbAccentFillHoverBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource VbPillSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource VbAccentFillPressedBrush}" />
                                        <Setter Target="PillContent.Foreground" Value="{ThemeResource VbPillSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="PillContent"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Кнопки ==================== -->
    <Style x:Key="VbAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="VbSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource VbCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VbCardEdgeBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource VbTextColorBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="VbDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource VbDangerTintBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VbDangerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource VbDangerBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="VbIconButtonStyle" TargetType="Button" BasedOn="{StaticResource VbSecondaryButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- ==================== Типографика из токенов (§3.3) ==================== -->
    <Style x:Key="VbSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource VbTextColorBrush}" />
    </Style>

    <Style x:Key="VbRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource VbTextColorBrush}" />
    </Style>

    <Style x:Key="VbCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource VbMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Заголовок окна в титлбаре: Title = 20 SemiBold (§3.3) -->
    <Style x:Key="VbTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource VbTextColorBrush}" />
    </Style>

    <!-- ==================== Журнал ==================== -->
    <Style x:Key="JournalLineStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="JournalTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource VbJournalTextBrush}" />
    </Style>

    <Style x:Key="JournalInfoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource JournalTextStyle}" />

    <Style x:Key="JournalWarningTextStyle" TargetType="TextBlock" BasedOn="{StaticResource JournalTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource VbWarningBrush}" />
    </Style>

    <Style x:Key="JournalErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource JournalTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource VbDangerBrush}" />
    </Style>

</ResourceDictionary>
